# Firebase Admin SDK (من Service Account)
FIREBASE_PROJECT_ID=storm-cafe-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@storm-cafe.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Waiter Auth
WAITER_PASSWORD=your_password_here
JWT_SECRET=any_random_long_string_here

# Telegram (نفس اللي عندك على Vercel)
TELEGRAM_BOT_TOKEN=your_token_here
